{
  "train_micro_batch_size_per_gpu" : 4,
  "gradient_accumulation_steps": 2,

  "optimizer": {
    "type": "Adam",
    "params": {
      "lr": 4e-4,
      "betas": [
      0.9,
      0.95
      ],
      "weight_decay": 1e-5,
      "eps": 1e-6
    }
  },
  "scheduler": {
      "type": "WarmupDecayLR",
      "params": {
          "total_num_steps": 50000,
          "warmup_min_lr": 0,
          "warmup_max_lr": 4e-4,
          "warmup_num_steps": 500,
          "warmup_type": "linear"
      }
  },
  "fp16": {
    "enabled": true,
    "auto_cast": true,
    "initial_scale_power": 12
  },
  "gradient_clipping": 1.0,
  "zero_optimization": {
    "stage": 3,
    "offload_param": {
      "device": "cpu"
    },
    "offload_optimizer": {
      "device": "cpu"
    }
  },

  "steps_per_print" : 10,
  "wall_clock_breakdown" : false
}